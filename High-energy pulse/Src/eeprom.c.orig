#include "main.h"
#include "cmsis_os2.h"
#include "eeprom.h"

#define AT24C02 255
#define AT24C16 2047
#define EE_TYPE AT24C16


//SDA:PB9
#define SDA_IN()  {GPIOB->MODER&=0XFFF3FFFF;}
#define SDA_OUT() {GPIOB->MODER&=0xFFF3FFFF;GPIOB->MODER|= 1<<18;}

#define I2C_SCL_HIGH  HAL_GPIO_WritePin(GPIOB,GPIO_PIN_8,GPIO_PIN_SET)
#define I2C_SCL_LOW  HAL_GPIO_WritePin(GPIOB,GPIO_PIN_8,GPIO_PIN_RESET)
#define I2C_SDA_HIGH  HAL_GPIO_WritePin(GPIOB,GPIO_PIN_9,GPIO_PIN_SET)
#define I2C_SDA_LOW  HAL_GPIO_WritePin(GPIOB,GPIO_PIN_9,GPIO_PIN_RESET)
#define I2C_SDA_READ  HAL_GPIO_ReadPin(GPIOB,GPIO_PIN_9)


/**************************************************************************************
*                                  HeaderFiles                            
**************************************************************************************/
unsigned char Bitack;
GPIO_InitTypeDef GPIO_InitStruct = {0};

//eeprom gpio init
void vI2C_init(void)
{
	__HAL_RCC_GPIOB_CLK_ENABLE();
	
	GPIO_InitStruct.Pin = GPIO_PIN_8|GPIO_PIN_9;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
	GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
	
    HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
	
}

static void I2C_DelayMs(uint16_t t)
{
    uint16_t i;
    while (t--)
    {
        for (i = 0; i < 400; i++)
        {
            __nop();
		__nop();
        }
    }
}

static void I2C_SomeNOP(uint16_t t)
{
    while (t--)
    {

		__nop();
		__nop();
		__nop();
		__nop();
		__nop();
			__nop();
		__nop();
		__nop();
		__nop();
		__nop();

    }
}


//I2C Start Bit
void I2C_Start(void)
{
	SDA_OUT();
	I2C_SCL_HIGH;
	I2C_SDA_HIGH;
  I2C_SomeNOP(5);
	I2C_SDA_LOW;
  I2C_SomeNOP(5);
	I2C_SCL_LOW;

}
//I2C Stop bit
void I2C_Stop(void)
{
	SDA_OUT();
	I2C_SCL_LOW;
	I2C_SDA_LOW;
  I2C_SomeNOP(5);
	I2C_SCL_HIGH;
	I2C_SDA_HIGH;
  I2C_SomeNOP(5);
}
//wait for the ack bit
//return :1  receive ack bit error
//        0  receive ack bit success
uint8_t I2C_Wait_Ack(void)
{
    uint8_t ucErrTime = 0;
    SDA_IN();
    I2C_SomeNOP(2);
    I2C_SCL_HIGH;
    I2C_SomeNOP(2);
    while (I2C_SDA_READ)
    {
	    ucErrTime++;
		if (ucErrTime > 250)
		{
			I2C_Stop();
			return 1;
		}
	}
	I2C_SCL_LOW;
	return 0;
}

void I2C_Ack(void)
{
  I2C_SCL_LOW;
  SDA_OUT();
  I2C_SDA_LOW;
  I2C_SomeNOP(5);
	I2C_SCL_HIGH;
  I2C_SomeNOP(5);
	I2C_SCL_LOW;
}


void I2C_NAck(void)
{
	I2C_SCL_LOW;
  SDA_OUT();
	I2C_SDA_HIGH;
  I2C_SomeNOP(5);
	I2C_SCL_HIGH;
  I2C_SomeNOP(5);
	I2C_SCL_LOW;
}

void I2C_Send_Byte(uint8_t txd)
{
    uint8_t t;
    SDA_OUT();
    I2C_SCL_LOW; 
    for (t = 0; t < 8; t++)
    {
        if ((txd << t) & 0x80)
            I2C_SDA_HIGH; 
        else
            I2C_SDA_LOW;
        I2C_SomeNOP(2);
        I2C_SCL_HIGH; 
        I2C_SomeNOP(10);  
        I2C_SCL_LOW;
		I2C_SomeNOP(2);
    }
}

uint8_t I2C_Read_Byte(uint8_t ack)
{
    unsigned char i, receive = 0;
    SDA_IN(); 
    for (i = 0; i < 8; i++)
    {
        I2C_SCL_LOW;
        I2C_SomeNOP(5);
        I2C_SCL_HIGH;
        receive <<= 1;
        if (I2C_SDA_READ)
            receive++;
        I2C_SomeNOP(5);
    }
    if (!ack)
        I2C_NAck(); 
    else
        I2C_Ack(); 
    return receive;
}

uint8_t AT24CXX_ReadOneByte(uint16_t ReadAddr)
{
    uint8_t	temp = 0;
    I2C_Start();
    if (EE_TYPE > AT24C16)
    {
        I2C_Send_Byte(0XA0); 
        I2C_Wait_Ack();
        I2C_Send_Byte(ReadAddr >> 8); 
        I2C_Wait_Ack();
    }
    else
        I2C_Send_Byte(0XA0 + ((ReadAddr / 256) << 1)); 

    I2C_Wait_Ack();
    I2C_Send_Byte(ReadAddr % 256); 
    I2C_Wait_Ack();
    I2C_Start();
    I2C_Send_Byte(0XA1); 
    I2C_Wait_Ack();
    temp = I2C_Read_Byte(0);
    I2C_Stop(); 
    return temp;
}


void AT24CXX_WriteOneByte(uint16_t WriteAddr, uint8_t DataToWrite)
{
    I2C_Start();
    if (EE_TYPE > AT24C16)
    {
        I2C_Send_Byte(0xA0); 
        I2C_Wait_Ack();
        I2C_Send_Byte(WriteAddr >> 8);
        I2C_Wait_Ack();
    }
    else
    {
        I2C_Send_Byte(0XA0 + ((WriteAddr / 256) << 1)); 
    }
    I2C_Wait_Ack();
    I2C_Send_Byte(WriteAddr % 256); 
    I2C_Wait_Ack();
    I2C_Send_Byte(DataToWrite); 
    I2C_Wait_Ack();
    I2C_Stop(); 
    I2C_DelayMs(1000);
}
void AT24CXX_WriteOneByteN(uint16_t WriteAddr, uint8_t DataToWrite)
{
    I2C_Start();
    if (EE_TYPE > AT24C16)
    {
        I2C_Send_Byte(0xA0); 
        I2C_Wait_Ack();
        I2C_Send_Byte(WriteAddr >> 8);
        I2C_Wait_Ack();
    }
    else
    {
        I2C_Send_Byte(0XA0 + ((WriteAddr / 256) << 1)); 
    }
    I2C_Wait_Ack();
    I2C_Send_Byte(WriteAddr % 256); 
    I2C_Wait_Ack();
    I2C_Send_Byte(DataToWrite); 
    I2C_Wait_Ack();
    I2C_Stop(); 
}

void AT24CXX_WriteLenByte(uint16_t WriteAddr, unsigned int DataToWrite, uint8_t Len)
{
    uint8_t t;
    for (t = 0; t < Len; t++)
    {
        AT24CXX_WriteOneByte(WriteAddr + t, (DataToWrite >> (8 * t)) & 0xff);
    }
}


unsigned int AT24CXX_ReadLenByte(uint16_t ReadAddr, uint8_t Len)
{
    uint8_t t;
    unsigned int temp = 0;
    for (t = 0; t < Len; t++)
    {
        temp <<= 8;
        temp += AT24CXX_ReadOneByte(ReadAddr + Len - t - 1);
    }
    return temp;
}

uint8_t AT24CXX_Check(void)
{
    uint8_t temp;
    temp = AT24CXX_ReadOneByte(255); 
    if (temp == 0X55)
        return 0;
    else 
    {
        AT24CXX_WriteOneByte(255, 0X55);
        temp = AT24CXX_ReadOneByte(255);
        if (temp == 0X55)
            return 0;
    }
    return 1;
}


void AT24CXX_Read(uint16_t ReadAddr, uint8_t *pBuffer, uint16_t NumToRead)
{
    while (NumToRead)
    {
        *pBuffer++ = AT24CXX_ReadOneByte(ReadAddr++);
        NumToRead--;
    }
}

void AT24CXX_Write(uint16_t WriteAddr, uint8_t *pBuffer, uint16_t NumToWrite)
{
    while (NumToWrite--)
    {
        AT24CXX_WriteOneByte(WriteAddr, *pBuffer);
        WriteAddr++;
        pBuffer++;
    }
}

osMessageQueueId_t xEEWriteMsg;

void vWriteEETask(void *argument)
{
	EEprom_Msg_TypeDef xEEpromMsg; 
	uint8_t ee_record_num;
	xEEWriteMsg = osMessageQueueNew(5, sizeof(EEprom_Msg_TypeDef),NULL);
	
	for(;;)
	{
		if(osMessageQueueGet(xEEWriteMsg, &xEEpromMsg, NULL, 0) == osOK)
		{
			switch (xEEpromMsg.ucCmd)
			{
				case 0x01:
					ee_record_num = AT24CXX_ReadOneByte(EE_RECORD);
					for ( int i = 0; i < 8; i++ ) 
					{
						AT24CXX_WriteOneByteN((unsigned int)(EE_RECORD_BASE+ee_record_num * 8+i), xEEpromMsg.ucData[i]);
						osDelay(20);
					}
					ee_record_num ++;
					if ( ee_record_num == 100) 
					{
						ee_record_num = 0;
					}						
					AT24CXX_WriteOneByte (EE_RECORD, ee_record_num ); 
					break;
				case 0x02:
					AT24CXX_WriteOneByteN(EE_STATUS1,xEEpromMsg.ucData[0]);
					osDelay(20);
					AT24CXX_WriteOneByteN(EE_VOLTAGE1,xEEpromMsg.ucData[1]);
					osDelay(20);
					AT24CXX_WriteOneByteN(EE_VOLTAGE2,xEEpromMsg.ucData[2]);
					osDelay(20);
					break; 
				case 0x03: //baud rate
					AT24CXX_WriteOneByteN(EE_BPSH,xEEpromMsg.ucData[0]);
					osDelay(20);
					AT24CXX_WriteOneByteN(EE_BPSL,xEEpromMsg.ucData[1]);
					osDelay(20);
				break;
				case 0x04:    //time
					for(uint8_t i=0;i<5;i++)
					{
					AT24CXX_WriteOneByteN(EE_TIME+i,xEEpromMsg.ucData[i]);
					osDelay(20);
					}
					break;
				case 0x05:
					AT24CXX_WriteOneByteN(POWERON_CNT,xEEpromMsg.ucData[0]);
					osDelay(20);
				break;
				case 0x06: // set the parameter through uart
					if(xEEpromMsg.ucData[0])
					{
					AT24CXX_WriteOneByteN(EE_BEEPTIME,xEEpromMsg.ucData[0]);
					osDelay(20);
					}
					if(xEEpromMsg.ucData[1])
					{
						AT24CXX_WriteOneByteN(EE_VOLTAGE1,xEEpromMsg.ucData[1]);
						osDelay(20);
						AT24CXX_WriteOneByteN(EE_VOLTAGE2,xEEpromMsg.ucData[1]);
						osDelay(20);
					}
					if(xEEpromMsg.ucData[2])
					{
					AT24CXX_WriteOneByteN(EE_ALARMCYCLES,xEEpromMsg.ucData[2]);
					osDelay(20);
					}
					if(xEEpromMsg.ucData[3])
					{
					AT24CXX_WriteOneByteN(EE_SWITCHEN,xEEpromMsg.ucData[3]);
					osDelay(20);
					}
					if(xEEpromMsg.ucData[4])
					{
					AT24CXX_WriteOneByteN(EE_RELAYTIME,xEEpromMsg.ucData[4]);
					osDelay(20);
					}
				break;
        case 0x07:
          AT24CXX_WriteOneByteN(EE_TOUCHEN,xEEpromMsg.ucData[0]);
					osDelay(20);
				default:
					break;
					
			}
		}
		osDelay(10);
	}
}
