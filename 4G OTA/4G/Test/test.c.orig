}
void up_kaiguanstate2(char *shebei_id,uint32_t	messageid,uint32_t	timestamp,uint8_t pake,uint8_t paixu_0,uint8_t paixunum)
{
    char dbuf1[250];
    uint32_t k=0;
//	char *dbuf=mymalloc(4400);
    char dbuf[4400];
    uint8_t i=0;
    sprintf(dbuf1,"{\"messageid\": %d,\"timestamp\": %d,\"deviceid\": \"%s\",\"cmd\": \"CMD-106\",\"desired\": {\"sub\":%d,\"arrays\": [",messageid,timestamp,shebei_id,pake);
    sprintf(dbuf+k,"%s",dbuf1);
    k+=strlen(dbuf1);
    for(i=paixu_0; i<paixunum; i++)
    {
        memset(dbuf1,0,250);
        if(i==paixunum-1)
        {
            sprintf(dbuf1,"{\"device\": {\"id\": %d},\"status\": {\"switch\": %d,\"istimer\":1}",list_jibenxinxip[i].id,list_jibenxinxip[i].switchin);
        } else
        {
            sprintf(dbuf1,"{\"device\": {\"id\": %d},\"status\": {\"switch\": %d,\"istimer\":1},",list_jibenxinxip[i].id,list_jibenxinxip[i].switchin);
        }
        sprintf(dbuf+(i*strlen(dbuf1)),"%s",dbuf1);
        sprintf(dbuf+k,"%s",dbuf1);
        k+=strlen(dbuf1);
    }
    sprintf(dbuf+k,"]}}");
    k=0;
//	printf("%s\r\n",dbuf);
    ESP8266_SendString ( ENABLE, dbuf, 0, Single_ID_0 );               //发送数据
//	myfree(dbuf);

}
void up_kaiguanstate(char *shebei_id,uint32_t	messageid,uint32_t	timestamp,uint8_t paixunum)
{
    uint8_t	paixu_0=0,i=0,k=0,kl=0;
    k=paixunum/8;
    kl=paixunum%8;
    if(k!=0)
    {
        for(i=0; i<k; i++)
        {
            up_kaiguanstate2(shebei_id,	messageid,timestamp,i+1, paixu_0,paixu_0+8);
            paixu_0+=8;
        }
    }
    if(kl!=0)
    {
        up_kaiguanstate2(shebei_id,	messageid,timestamp,k+1, paixu_0,paixunum);
    }


}
