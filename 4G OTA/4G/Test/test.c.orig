/***********************************************************
  函数名称：Find_string(char *pcBuf,char*left,char*right, char *pcRes)
  函数功能：寻找特定字符串
  入口参数：
           char *pcBuf 为传入的字符串
           char*left   为搜索字符的左边标识符  例如："["
           char*right  为搜索字符的右边标识符  例如："]"
					 char *pcRes 为输出转存的字符串数组
  返回值：用来校验是否成功，无所谓的。
  备注：
 服务器下发命令举例：+MQTTPUBLISH: 0,0,0,0,/device/NB/zx99999999999999_back,6,[reastrobot]
***********************************************************/
int Find_string(char *pcBuf,char*left,char*right, char *pcRes)
{
    char *pcBegin = NULL;
    char *pcEnd = NULL;

    pcBegin = strstr(pcBuf, left);
    pcEnd = strstr(pcBuf, right);

    if(pcBegin == NULL || pcEnd == NULL || pcBegin > pcEnd)
    {
        printf("Mail name not found!\n");
    }
    else
    {
        pcBegin += strlen(left);
        memcpy(pcRes, pcBegin, pcEnd-pcBegin);
    }

    return 0;
}
uint32_t cifang(uint8_t n)
{   uint8_t i=0;
    uint32_t sum=1;
    for(i=0; i<n; i++)
    {
        sum=sum*10;
    }

    return sum;
}
/***********************************************************
  函数名称：Str_To_ASC （适用于ME3616）
  函数功能：遍历字符串   逐个处理分析转为ASCII格式给NB
  入口参数：char* a
  出口参数：无
  备 注：
  ##0112QN=20190306152401;ST=32;CN=51;PW=CITC2018+;MN=112019015222;Flag=5 ;CP=&&LA=30;TE=25;HU=75;&&1C80\r\n
***********************************************************/
uint32_t Str_To_ASC(char* a)
{
    int i,k=0,hj=1,nk=0;
    uint8_t w;
    uint32_t sum=0;
    int x;
    for (i = 0; a[i] != '\0'; i++)
    {
//		if(a[i]=='-')
//		{
//			hj=1;
//		}
        if (a[i] >= '0' && a[i] <= '9'&&nk==0) //数字处理
        {
            k++;
        } else
        {
            if(k!=0)
            {
                nk=1;
            }
        }
    }
    i=k;
    while (i--)
    {
        if (a[i] >= '0' && a[i] <= '9') //数字处理
        {
            w = a[i] - '0'; //单个字符转  int
            sum+=w*cifang(k-1-i);

        }
    }
    sum=sum*hj;
    return sum;

}
void struct_init()
{   uint8_t i=0;
    for(i=0; i<paixuNO; i++)
    {
        list_paixunum[i].index=i+1;
        list_paixunum[i].id=((SSN[i][0]<<24)+(SSN[i][1]<<16)+(SSN[i][2]<<8)+SSN[i][3]);
//		(list_paixunum[i].mode)="v";
        strcpy(list_paixunum[i].mode,"C63");
        list_paixunum[i].type=2;//2分开关 1主开关
        list_paixunum[i].np=0;//2p
        list_paixunum[i].leakage=1;//1带漏电 0不带漏电

        list_jibenxinxip[i].id=((SSN[i][0]<<24)+(SSN[i][1]<<16)+(SSN[i][2]<<8)+SSN[i][3]);
        list_jibenxinxip[i].autoin=0;
        list_jibenxinxip[i].leakage=1;
        list_jibenxinxip[i].switchin=0;
        list_jibenxinxip[i].current=0;
        list_jibenxinxip[i].temp=340;
        list_jibenxinxip[i].voltage=2300;
        list_jibenxinxip[i].power=0;
    }


}
void UP_baseinformation(char *shebei_id,	uint32_t	messageid,uint32_t	timestamp)
{
    uint8_t i=0;
    caxun_allkaiguan(paixuNO);
    paixu_yingda(shebei_id,messageid,timestamp,paixuNO);
    Delay_ms (20);
    for(i=0; i<paixuNO; i++)
    {
        Dengdai_ITflagn=0;
        shezi_kaiguan(i+1);
        if(Dengdai_ITrflag==0)
        {
            shezi_kaiguan(i+1);
        }
        if(Dengdai_ITrflag==1)
        {
            UP_SZ_data(shebei_id,messageid,timestamp,i+1);
            Delay_ms (10);
            Dengdai_ITrflag=0;
        }
    }


}
void gettime_timeamp(uint32_t	timestamp)
{
    struct tm *tn;
    char *cStr;
    char buf[160];
    uint32_t	timestamp_AS=0;
    cStr=(char*)mymalloc(800);
    while(strEsp8266_Fram_Record .InfBit .FramFinishFlag==0 )
    {


    }
    strEsp8266_Fram_Record .Data_RX_BUF [ strEsp8266_Fram_Record .InfBit .FramLength ] = '\0';
    cStr = strEsp8266_Fram_Record .Data_RX_BUF;
    strEsp8266_Fram_Record .InfBit .FramFinishFlag=0;
    strEsp8266_Fram_Record .InfBit .FramLength = 0;
    if ( strstr ( cStr, "\"timestamp\":" ) )
    {
        memset(buf,0,160);
        Find_string(cStr,"\"timestamp\":","\"deviceid\"" ,buf);
        timestamp=Str_To_ASC(buf);
    }
    memset(cStr,0,800);
    myfree(cStr);
    timestamp_AS=timestamp+28800;
    tn=localtime(&timestamp_AS);
    printf("%04d-%02d-%02d %02d:%02d:%02d\r\n", tn->tm_year+1900,tn->tm_mon+1, tn->tm_mday, tn->tm_hour, tn->tm_min, tn->tm_sec);
    sDefaultTime.year = tn->tm_year;
    sDefaultTime.month = tn->tm_mon;
    sDefaultTime.mday = tn->tm_mday;
    sDefaultTime.wday = tn->tm_wday;
    sDefaultTime.hour =tn->tm_hour;
    sDefaultTime.min = tn->tm_min;
    sDefaultTime.sec =tn->tm_sec;


}
