//	char shebei_id[20]="MT419B5032";
//	="{ \"messageid\": 12133422,\"timestamp\": 1564288331,\"deviceid\": \"MT419B5032\",\"cmd\": \"CMD-202\", \"desired\": {\"type\":\"Login\",\"method\":\"wifi\"}}";
    sprintf(buff,"{ \"messageid\": %d,\"timestamp\": %d,\"deviceid\": \"%s\",\"cmd\": \"CMD-104\", \"desired\": {\"arrays\": [{\"device\": { \"id\": %d},\"getparam\":{ \"loadmax\":%d , \"elecmax\": %d, \"tempmax\": %d, \"currmax\": %d, \"voltmax\": %d, \"voltmin\": %d, \"voltime\": %d, \"volrest\": %d,\"leakage\": %d}}]}}"
            ,messageid,timestamp,shebei_id,list_jibenxinxip[paixunum-1].id,workSZdata[paixunum-1].limit_power_p,workSZdata[paixunum-1].limit_total_enery_p,workSZdata[paixunum-1].limit_ntc_temperature,workSZdata[paixunum-1].limit_attdata_amp,workSZdata[paixunum-1].limit_high_attdata_volt,workSZdata[paixunum-1].limit_Low_attdata_volt,workSZdata[paixunum-1].volt_action_time,workSZdata[paixunum-1].volt_recovery_time,workSZdata[paixunum-1].Leakage_detection);
